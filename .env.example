# Supabase Configuration
# Get these values from your Supabase project settings at https://supabase.com/dashboard

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API key — powers the live Campus AI assistant.
# Get a key at https://aistudio.google.com/apikey
# Without it, Campus AI runs in offline (local knowledge) mode.
VITE_GEMINI_API_KEY=your_gemini_api_key
